class LinkedList:
    def __init__(self, num, next):
        self.num = num
        self.next = next
    def show(self):
        temp = self
        result = ""
        while (temp):
            # print(temp.num)
            result = result + "|" + temp.num + "|"
            temp = temp.next
        print(result)
    def length(self):
        (temp, num) = (self, 0)
        while temp is not None:
            num += 1
            temp = temp.next
        return num
    def add(self, value):
        return LinkedList(value, self)
    def rest(self):
        if self.next is None:
            return None
        else:
            return self.next
    def append(self, value):
        if self.next is None:
            self.next = LinkedList(value, None)
        else:
            self.next.append(value)
